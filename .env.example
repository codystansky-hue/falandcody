# Neon — injected automatically by the Vercel Marketplace integration
DATABASE_URL=

# Gate (required)
GATE_SECRET=
GATE_PASSPHRASE=
ADMIN_PASSPHRASE=

# Optional — /flights stays in its "not configured" state without this.
# Free token: https://www.travelpayouts.com  (Profile -> API token)
TRAVELPAYOUTS_TOKEN=

# Optional — /arrivals live tracking stays dark without these.
# Free OAuth2 client: https://opensky-network.org  (Account -> API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
