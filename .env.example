# ── Required to run at all ───────────────────────────────────────────────────

# Neon Postgres. Injected automatically by the Vercel Marketplace integration,
# or paste a connection string from neon.tech. Without it every page still
# renders; only the RSVP form says it has nowhere to put replies.
DATABASE_URL=

# Signs the gate cookie. Any long random string — `openssl rand -hex 32`.
# Changing it logs everybody out, which is the only reason you would.
GATE_SECRET=

# The word on the invitation. Guests type this once and stay in for 90 days.
GATE_PASSPHRASE=

# A DIFFERENT word, for /admin. This one sees emails, addresses and the CSV
# export, so do not reuse the guest passphrase.
ADMIN_PASSPHRASE=

# ── Optional ─────────────────────────────────────────────────────────────────

# Second source of flight prices. Everything on /travel works without it —
# the journey model, the cost estimate and the search links need no key.
# Free token: https://www.travelpayouts.com  (Profile -> API token)
TRAVELPAYOUTS_TOKEN=

# Live "on the ground" flags on /arrivals. The board itself works without
# these, off the times guests typed in.
# Free OAuth2 client: https://opensky-network.org  (Account -> API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
